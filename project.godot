; Engine configuration file.
; Best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Voivent Neural Material"
config/description="VNM1 neural PBR material decoder and runtime loader for Godot 4.7+"
run/main_scene="res://demo/sample_scene.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/voivent_neural_material/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
